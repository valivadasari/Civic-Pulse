# CivicPulse AI - Environment Configuration
# For Vercel or local development, copy this file to .env or .env.local

# Optional: Google Gemini API Key for genuine multimodal vision analysis
# Obtain from https://aistudio.google.com/app/apikey
# If omitted, the application operates in transparent Simulated Demo Mode.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
